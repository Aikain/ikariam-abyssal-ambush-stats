{
    "extends": "@ikariam-abyssal-ambush-stats/typescript-config/vite-react.json",
    "compilerOptions": {
        "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.tsbuildinfo",
        "types": [
            "vite/client",
            "chrome",
        ],
        "paths": {
            "@/hooks/*": [
                "./src/hooks/*",
            ],
            "@/icons/*": [
                "./src/assets/icons/*",
            ],
        },
    },
    "include": [
        "src",
    ],
}
