        "@types/react": "^19.2.17",
        "@types/react-dom": "^19.2.3",
        "@vitejs/plugin-react": "^6.0.3",
        "babel-plugin-react-compiler": "^1.0.0",
        "eslint": "^9.39.5",
        "typescript": "^6.0.3",
        "vite": "^8.1.5",
        "vitest": "^4.1.10"
